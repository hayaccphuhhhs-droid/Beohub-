local multiCodes = ""

Tab8:CreateInput({
    Name = "Nhập Nhiều Code (mỗi dòng 1 code)",
    PlaceholderText = "Code1\nCode2\nCode3",
    Numeric = false,
    Value = "",
    Flag = "MultiCodeInput",
    Callback = function(Value)
        multiCodes = Value
    end,
})

Tab8:CreateButton({
    Name = "🎁 Nhập Tất Cả Code Đã Nhập",
    Callback = function()
        if multiCodes == "" or not multiCodes then
            Rayfield:Notify({Title = "⚠️ Lỗi", Content = "Vui lòng nhập code!", Duration = 3})
            return
        end
        
        local codes = {}
        for code in multiCodes:gmatch("[^\r\n]+") do
            table.insert(codes, code)
        end
        
        Rayfield:Notify({Title = "🎁 Đang nhập...", Content = "Tổng cộng: " .. #codes .. " code", Duration = 3})
        
        task.spawn(function()
            for i, code in ipairs(codes) do
                RedeemCode(code)
                print("[" .. i .. "/" .. #codes .. "] " .. code)
                task.wait(0.5)
            end
            Rayfield:Notify({Title = "✅ Xong!", Content = "Đã nhập " .. #codes .. " code!", Duration = 5})
        end)
    end,
})

