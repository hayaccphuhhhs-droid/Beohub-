local Tab5 = Window:CreateTab("🎁 Auto Code", 4483362458)

local function Redeem(code)
    pcall(function()
        if RS:FindFirstChild("Events") and RS.Events:FindFirstChild("RedeemCode") then
            RS.Events.RedeemCode:FireServer(code)
        elseif RS:FindFirstChild("Events") and RS.Events:FindFirstChild("Code") then
            RS.Events.Code:FireServer(code)
        elseif RS:FindFirstChild("RedeemCode") then
            RS.RedeemCode:FireServer(code)
        elseif RS:FindFirstChild("Code") then
            RS.Code:FireServer(code)
        end
    end)
end

local customCode = ""

