local multiCode = ""

Tab5:CreateInput({
    Name = "Nhập Nhiều Code",
    PlaceholderText = "Code1\nCode2\nCode3",
    Numeric = false,
    Value = "",
    Flag = "MultiCode",
    Callback = function(v) multiCode = v end
})

Tab5:CreateButton({
    Name = "🎁 Nhập Tất Cả",
    Callback = function()
        if multiCode == "" then return end
        local codes = {}
        for code in multiCode:gmatch("[^\r\n]+") do
            table.insert(codes, code)
        end
        task.spawn(function()
            for i, code in ipairs(codes) do
                Redeem(code)
                task.wait(0.5)
            end
            Rayfield:Notify({Title = "✅ Xong!", Content = "Đã nhập " .. #codes .. " code", Duration = 3})
        end)
    end
})

