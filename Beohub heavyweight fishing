local Tab8 = Window:CreateTab("🎁 Auto Code", 4483362458)

local function RedeemCode(code)
    pcall(function()
        if RS:FindFirstChild("Events") then
            local events = RS.Events
            if events:FindFirstChild("RedeemCode") then
                events.RedeemCode:FireServer(code)
            elseif events:FindFirstChild("Code") then
                events.Code:FireServer(code)
            elseif events:FindFirstChild("Redeem") then
                events.Redeem:FireServer(code)
            end
        elseif RS:FindFirstChild("RedeemCode") then
            RS.RedeemCode:FireServer(code)
        elseif RS:FindFirstChild("Code") then
            RS.Code:FireServer(code)
        elseif RS:FindFirstChild("Redeem") then
            RS.Redeem:FireServer(code)
        end
    end)
end

