    end
end)

RunService.RenderStepped:Connect(function()
    if getgenv().NWKZ_Anchor then
        pcall(function()
            local gui = lp.PlayerGui:FindFirstChild("MainGui")
            local fishingUI = gui and gui:FindFirstChild("Fishing")
            if fishingUI and fishingUI.Visible then
                local bar = fishingUI:FindFirstChild("BarFrame") and fishingUI.BarFrame:FindFirstChild("Bar")
                if bar then bar.Position = UDim2.new(0.5, 0, bar.Position.Y.Scale, 0) end
                if RS:FindFirstChild("Events") and RS.Events:FindFirstChild("Fishing") then
                    RS.Events.Fishing:FireServer("1")
                end
            end
        end)
    end
end)

task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local char = lp.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end

            if getgenv().PP_AutoSkillAll or getgenv().PP_Skill_Z then
                VIM:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                task.wait(0.15)
                VIM:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
                task.wait(0.1)
            end
            if getgenv().PP_AutoSkillAll or getgenv().PP_Skill_X then
                VIM:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                task.wait(0.15)
                VIM:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                task.wait(0.1)
            end
            if getgenv().PP_AutoSkillAll or getgenv().PP_Skill_C then
                VIM:SendKeyEvent(true, Enum.KeyCode.C, false, game)
                task.wait(0.15)
                VIM:SendKeyEvent(false, Enum.KeyCode.C, false, game)
                task.wait(0.1)
            end
            if getgenv().PP_AutoSkillAll or getgenv().PP_Skill_V then
                VIM:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                task.wait(0.15)
                VIM:SendKeyEvent(false, Enum.KeyCode.V, false, game)
                task.wait(0.1)
            end
        end)
    end
end)

RunService.Stepped:Connect(function()
    pcall(function()
        local char = lp.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = getgenv().PP_WalkSpeed or 16
        end
        if getgenv().PP_Noclip and char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)
end)

