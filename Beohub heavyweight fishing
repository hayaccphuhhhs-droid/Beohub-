            end)
            task.wait(getgenv().SellInterval or 5)
        end
    end
end)

-- Auto Anchor
RunService.RenderStepped:Connect(function()
    if getgenv().Anchor then
        pcall(function()
            local pg = lp:FindFirstChild("PlayerGui")
            if not pg then return end
            local ui = (pg:FindFirstChild("MainGui") and pg.MainGui:FindFirstChild("Fishing")) or pg:FindFirstChild("Fishing") or pg:FindFirstChild("FishingUI")
            if ui and ui.Visible then
                local bf = ui:FindFirstChild("FishingBar") or ui:FindFirstChild("BarFrame") or ui:FindFirstChild("Bar")
                if bf then
                    local bar = bf:FindFirstChild("Bar") or bf:FindFirstChild("Slider") or bf:FindFirstChild("Progress") or bf:FindFirstChild("Pointer")
                    if bar and bar:IsA("GuiObject") then
                        bar.Position = UDim2.new(0.5, 0, bar.Position.Y.Scale, 0)
                    end
                end
                if RS:FindFirstChild("Fishing") then
                    RS.Fishing:FireServer("1")
                elseif RS:FindFirstChild("Events") and RS.Events:FindFirstChild("Fishing") then
                    RS.Events.Fishing:FireServer("1")
                end
            end
        end)
    end
end)

-- Auto Skill (delay 1s)
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local char = lp.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end

            if getgenv().AutoSkillAll or getgenv().SkillZ then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
                task.wait(0.1)
            end
            if getgenv().AutoSkillAll or getgenv().SkillX then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                task.wait(0.1)
            end
            if getgenv().AutoSkillAll or getgenv().SkillC then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.C, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.C, false, game)
                task.wait(0.1)
            end
            if getgenv().AutoSkillAll or getgenv().SkillV then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.V, false, game)
                task.wait(0.1)
            end
        end)
    end
end)

-- Speed + Noclip
RunService.Stepped:Connect(function()
    pcall(function()
        local char = lp.Character
        if char and char:FindFirstChild("Humanoid") then
            if getgenv().Speed then
                char.Humanoid.WalkSpeed = getgenv().Speed
            end
        end
        if getgenv().Noclip and char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end)

