-- ======================= ANTI-TAMPER =======================
local _AntiTamper = {}
function _AntiTamper.checkHttpGet() return type(game.HttpGet) == "function" end
function _AntiTamper.checkLoadstring() return type(loadstring) == "function" or type(load) == "function" end
function _AntiTamper.checkGame() return type(game) == "userdata" end
function _AntiTamper.checkURL(_u)
    if type(_u) ~= "string" then return false end
    if #_u < 20 then return false end
    if not string.find(_u, "https://") then return false end
    return true
end
function _AntiTamper.computeHash(_s)
    local _h = 5381
    for _i = 1, #_s do
        _h = ((_h * 33) + string.byte(_s, _i)) % 2147483647
    end
    return _h
end
function _AntiTamper.verifyURL(_u)
    local _h = _AntiTamper.computeHash(_u)
    if _DEBUG then warn(_PREFIX, "URL hash:", _h) end
    return true
end

-- Chạy check
if not _AntiTamper.checkHttpGet() then
    warn(_PREFIX, "Executor không hỗ trợ HttpGet!")
    return
end
if not _AntiTamper.checkLoadstring() then
    warn(_PREFIX, "Executor không hỗ trợ loadstring!")
    return
end
if not _AntiTamper.checkURL(_URL) then
    warn(_PREFIX, "URL không hợp lệ!")
    return
end
if not _AntiTamper.verifyURL(_URL) then
    warn(_PREFIX, "URL bị sửa!")
    return
end

-- ======================= FETCH VỚI RETRY =======================
local function _fetchWithRetry(_url, _max)
    _max = _max or 3
    local _lastErr
    for _att = 1, _max do
        local _ok, _res = pcall(function()
            return game:HttpGet(_url)
        end)
        if _ok and _res and #_res > 10 then
            return _res, nil
        else
            _lastErr = _ok and "Empty" or tostring(_res)
            if _DEBUG then warn(_PREFIX, "Attempt " .. _att .. " failed: " .. _lastErr) end
            if _att < _max then
                if task and task.wait then task.wait(1) else wait(1) end
            end
        end
    end
    return nil, _lastErr
end

local _code, _err = _fetchWithRetry(_URL, 3)
if not _code then
    warn(_PREFIX, "Không tải được code: " .. tostring(_err))
    return
end

_logger:info("Downloaded: " .. #_code .. " bytes")

-- ======================= VALIDATOR =======================
local _Validator = {}
function _Validator.checkSyntax(_s) return #_s > 0 end
function _Validator.checkSize(_s) return #_s > 10 and #_s < 10000000 end
function _Validator.checkEncoding(_s) return true end
function _Validator.checkMalicious(_s) return true end
function _Validator.validate(_s)
    local _checks = {
        {n = "syntax", f = function() return _Validator.checkSyntax(_s) end},
        {n = "size", f = function() return _Validator.checkSize(_s) end},
        {n = "encoding", f = function() return _Validator.checkEncoding(_s) end},
        {n = "malicious", f = function() return _Validator.checkMalicious(_s) end},
    }
    for _i = 1, #_checks do
        if not _checks[_i].f() then
            return false, _checks[_i].n
        end
    end
    return true, nil
end

local _valid, _reason = _Validator.validate(_code)
if not _valid then
    warn(_PREFIX, "Code không hợp lệ: " .. tostring(_reason))
    return
end

-- ======================= LOAD & RUN =======================
local function _safeRun(_src, _name)
    local _fn, _cErr = (loadstring or load)(_src, _name or "=BeoHub")
    if not _fn then
        return false, "Compile: " .. tostring(_cErr)
    end
    local _ok, _rErr = pcall(_fn)
    if not _ok then
        return false, "Runtime: " .. tostring(_rErr)
    end
    return true, nil
end

local _runOK, _runErr = _safeRun(_code, "=BeoHubLoader")
if not _runOK then
    warn(_PREFIX, "Chạy thất bại: " .. tostring(_runErr))
