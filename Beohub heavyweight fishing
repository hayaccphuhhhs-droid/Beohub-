-- ======================= BASE64 DECODER =======================
local _B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function _b64decode(_data)
    _data = string.gsub(_data, "[^" .. _B64 .. "=]", "")
    local _out = {}
    local _buf, _bits = 0, 0
    for _i = 1, #_data do
        local _c = string.sub(_data, _i, _i)
        if _c ~= "=" then
            local _v = string.find(_B64, _c, 1, true) - 1
            _buf = _buf * 64 + _v
            _bits = _bits + 6
            if _bits >= 8 then
                _bits = _bits - 8
                local _byte = math.floor(_buf / (2 ^ _bits)) % 256
                table.insert(_out, string.char(_byte))
            end
        end
    end
    return table.concat(_out)
end

